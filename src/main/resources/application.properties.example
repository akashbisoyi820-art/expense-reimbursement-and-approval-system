spring.application.name=expense-reimbursement-system
spring.datasource.url=jdbc:mysql://localhost:3306/expense_db
spring.datasource.username=root
spring.datasource.password=your_password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
jwt.secret=change-this-to-a-long-random-secret-key-at-least-32-chars
jwt.expiration=86400000
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
file.upload-dir=uploads/receipts
# Optional: exchange rate API (free, no key needed). This is the default.
exchange.api.base-url=https://api.frankfurter.dev